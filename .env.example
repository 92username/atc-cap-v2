# ========================
# APP CONFIG
# ========================
APP_ENV=local
DEBUG=True
OAUTH_REDIRECT_BASE_URL=http://localhost:8506

# ========================
# ADMIN & ACCESS CONTROL
# ========================
ADMIN_EMAILS=devEmail@gmail.com
ALLOWED_EMAILS=emailsautorizados@exemplo.com,outroemailautorizado@exemplo.com
# ========================
# GOOGLE OAUTH
# ========================
GOOGLE_CLIENT_ID="value"
GOOGLE_CLIENT_SECRET="chave secreta do cliente"
OAUTH_GOOGLE_ENABLED=True

# ========================
# MICROSOFT OAUTH
# ========================
OAUTH_MICROSOFT_ENABLED=True
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
MICROSOFT_AUTHORIZE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_CLIENT_ID="seu id microsoft"
MICROSOFT_CLIENT_SECRET="seu segredo microsoft"
MICROSOFT_REDIRECT_URI=http://localhost:8501/login/microsoft/callback
MICROSOFT_SCOPES="openid email profile offline_access"
MICROSOFT_TENANT_ID=common

# ========================
# GITHUB CONTAINER REGISTRY
# ========================
GHCR_USERNAME=SEU_GHCR_USERNAME
GHCR_TOKEN=SEU_GHCR_TOKEN

# ========================
# VPS DEPLOY CONFIG (SSH)
# ========================
VPS_HOST=seu.vps.host
VPS_USER=root
VPS_KEY=/caminho/para/sua/chave/id_rsa

# ========================
# OTHER
# ========================
SECRET_KEY=chave-super-secreta-local
