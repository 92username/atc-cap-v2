# ===========================
# APP CONFIG
# ===========================
APP_NAME=tatic-processor
APP_PORT=8506
APP_ENV=production
APP_DEBUG=false

# ===========================
# STREAMLIT CONFIG
# ===========================
STREAMLIT_SERVER_PORT=${APP_PORT}
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_LOG_LEVEL=info

# ===========================
# PATHS E PERSISTÊNCIA
# ===========================
REPORTS_DIR=/data/uploads       # pasta persistente (montada no volume)
OUTPUT_DIR=/data/uploads        # diretório usado pela aplicação para uploads/outputs

# ===========================
# GITHUB / GHCR CONFIG
# ===========================
GHCR_USERNAME=92username
GHCR_REPO=streamlit-app
GHCR_IMAGE_TAG=0.0.1

# ===========================
# VPS DEPLOY CONFIG
# ===========================
VPS_HOST=0.0.0.0                # IP da VPS Hostinger
VPS_USER=root                   # ou ubuntu, se aplicável
VPS_APP_PATH=/var/www/streamlit-app
VPS_PORT=${APP_PORT}

# ===========================
# SECRETS (definir no GitHub Secrets)
# ===========================
# GHCR_TOKEN      -> Personal Access Token com write:packages
# VPS_KEY         -> Chave privada SSH (~/.ssh/id_rsa)
# ENV_FILE        -> Conteúdo do .env real (caso queira replicar via CI/CD)
# fake commit
